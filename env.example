# Power BI Credentials
POWERBI_EMAIL=example@highmor.com
POWERBI_PASSWORD=your_password_here

# Power BI Report Configuration
POWERBI_REPORT_URL=https://app.powerbi.com/groups/your-workspace-id/reports/your-report-id

# Email Configuration
EMAIL_ADDRESS=example@highmor.com
EMAIL_PASSWORD=your_outlook_password_here
# For Outlook/Office 365, use your regular password or App Password if 2FA is enabled

# SMTP Configuration (Outlook/Office 365)
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587

# Default Recipients (comma-separated)
DEFAULT_RECIPIENTS=recipient1@example.com,recipient2@example.com

# Default Email Settings
DEFAULT_SUBJECT=Power BI Report - Last 30 Days
DEFAULT_BODY=Please find attached the Power BI report for the last 30 days.

# File Paths
DOWNLOADS_FOLDER=downloads
OUTPUT_FOLDER=output
LOGS_FOLDER=logs

# Automation Method (API is recommended)
USE_API=True
# Set to False to use browser automation instead

